# ==============================================================================
# PAX GADGETS — PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development, or configure these variables
# in your hosting dashboard (Vercel, Cloudflare, AWS, or Docker).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://paxgadgets.ng"
NEXT_PUBLIC_BRAND_NAME="PAX Gadgets"
NEXT_PUBLIC_CURRENCY_CODE="NGN"
NEXT_PUBLIC_CURRENCY_SYMBOL="₦"
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 2. PAYMENT GATEWAYS (NIGERIA & PAN-AFRICAN FULFILLMENT)
# ------------------------------------------------------------------------------
# PAYSTACK (Primary NGN Gateway: Card, Bank Transfer, USSD, Apple Pay)
# Obtain from: https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="your_paystack_public_key_here"
PAYSTACK_SECRET_KEY="your_paystack_secret_key_here"
PAYSTACK_WEBHOOK_SECRET="your_paystack_webhook_secret_here"

# FLUTTERWAVE (Fallback Gateway & International Cards)
# Obtain from: https://dashboard.flutterwave.com/settings/apis
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY="your_flutterwave_public_key_here"
FLUTTERWAVE_SECRET_KEY="your_flutterwave_secret_key_here"
FLUTTERWAVE_ENCRYPTION_KEY="your_flutterwave_encryption_key_here"
FLUTTERWAVE_WEBHOOK_SECRET_HASH="your_custom_secret_hash_here"

# ------------------------------------------------------------------------------
# 3. AI SPECIFICATION ADVISOR & INTELLIGENT HARDWARE MATCHER
# ------------------------------------------------------------------------------
# GOOGLE GEMINI API (Recommended for fast low-latency specification reasoning)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_google_gemini_api_key_here"

# OPENAI API (Alternative LLM engine)
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key_here"

# AI GATEWAY (Optional: Cloudflare / Vercel AI Gateway for rate limiting & caching)
AI_GATEWAY_URL="https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}"
AI_GATEWAY_TOKEN="your_gateway_token_here"

# ------------------------------------------------------------------------------
# 4. CUSTOMER AUTHENTICATION & SECURITY TOKENS
# ------------------------------------------------------------------------------
# NEXTAUTH / AUTH.JS (Customer session encryption & JWT tokens)
# Generate with: openssl rand -base64 32
AUTH_SECRET="your_long_32_byte_random_string_here"
NEXTAUTH_URL="https://paxgadgets.ng"

# GOOGLE OAUTH 2.0 (For one-click customer sign-in)
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# ADMINISTRATIVE & DISTRIBUTOR PORTAL TOKENS
# Used to sign session tokens for internal logistics riders & admins
ADMIN_JWT_SECRET="your_long_admin_token_signing_secret_here"
ADMIN_SESSION_COOKIE_NAME="pax_admin_secure_token"

# ------------------------------------------------------------------------------
# 5. DATABASE & PERSISTENT STORAGE
# ------------------------------------------------------------------------------
# POSTGRESQL (Supabase / Neon / AWS RDS - replaces in-memory stores)
# Schema: Orders, Products, Stock Quantities, Distributors, Delivery Logs
DATABASE_URL="postgresql://postgres:password@localhost:5432/paxgadgets"

# SUPABASE (If using Supabase Auth & Row Level Security)
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# UPSTASH REDIS (For cart session sync, live checkout inventory locks, and rate limits)
# Obtain from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token_here"

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL NOTIFICATIONS (SMS, WHATSAPP & EMAIL)
# ------------------------------------------------------------------------------
# TERMII (High-delivery transactional SMS & WhatsApp for Nigeria +234 phone numbers)
# Obtain from: https://termii.com/dashboard
TERMII_API_KEY="your_termii_api_key_here"
TERMII_SENDER_ID="PAXGadgets"

# RESEND (Transactional order receipts, dispatch updates, warranty registrations)
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY="your_resend_api_key_here"
EMAIL_FROM="PAX Gadgets <orders@paxgadgets.ng>"
SUPPORT_EMAIL="support@paxgadgets.ng"

# ------------------------------------------------------------------------------
# 7. LOGISTICS, MAPS & DISPATCH AUTOMATION
# ------------------------------------------------------------------------------
# GOOGLE MAPS API (Address Geocoding, Places Autocomplete & Delivery Distance)
# Obtain from: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# SHIPBUBBLE / GIG LOGISTICS (Automated third-party delivery dispatch API)
# Obtain from: https://shipbubble.com/ or https://giglogistics.com/
SHIPBUBBLE_API_KEY="your_shipbubble_api_key_here"

# ------------------------------------------------------------------------------
# 8. CLOUD ASSETS & 3D MODEL CDN
# ------------------------------------------------------------------------------
# AWS S3 or CLOUDINARY (For high-resolution product photography & Three.js 3D GLTF assets)
AWS_REGION="eu-west-1"
AWS_S3_BUCKET="paxgadgets-hardware-assets"
AWS_ACCESS_KEY_ID="your_aws_access_key_id_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key_here"
NEXT_PUBLIC_CDN_URL="https://cdn.paxgadgets.ng"

# ------------------------------------------------------------------------------
# 9. MONITORING, TELEMETRY & ERROR TRACKING
# ------------------------------------------------------------------------------
# SENTRY (Crash reporting & runtime error tracking)
# Obtain from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o000000.ingest.sentry.io/0"

# POSTHOG (Privacy-first product analytics)
# Obtain from: https://app.posthog.com/
NEXT_PUBLIC_POSTHOG_KEY="your_posthog_key_here"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
